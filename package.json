{
  "name": "confeccionesjuany",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "concurrently -n web,server \"npm run dev:web\" \"npm run dev:server\"",
    "dev:web": "npm -w @confeccionesjuany/web run dev",
    "dev:server": "npm -w @confeccionesjuany/server run dev",
    "build": "npm -w @confeccionesjuany/web run build && npm -w @confeccionesjuany/server run build",
    "start": "npm -w @confeccionesjuany/server run start",
    "lint": "npm -w @confeccionesjuany/web run lint && npm -w @confeccionesjuany/server run lint",
    "db:migrate": "npm -w @confeccionesjuany/server run db:migrate",
    "db:deploy": "npm -w @confeccionesjuany/server run db:deploy",
    "db:seed": "npm -w @confeccionesjuany/server run db:seed",
    "db:studio": "npm -w @confeccionesjuany/server run db:studio",
    "test": "npm -w @confeccionesjuany/server run test",
    "test:e2e": "playwright test",
    "staging": "bash scripts/staging.sh",
    "test:staging": "playwright test -c playwright.staging.config.ts"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@types/node": "^25.5.0",
    "concurrently": "^9.2.1"
  }
}
