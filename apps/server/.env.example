# Server
NODE_ENV=development
PORT=3001

# SQLite (ruta relativa a `apps/server/prisma/schema.prisma`)
DATABASE_URL="file:./dev.db"

# Auth (cambia esto en producción)
JWT_SECRET="cambia-esto-por-una-frase-larga-y-random-minimo-32-caracteres"

# Admin seed (se usa en `npm run db:seed`)
ADMIN_EMAIL="admin@ejemplo.com"
ADMIN_PASSWORD="cambia-esto"

# Gmail SMTP (idealmente App Password)
SMTP_USER="tu.gmail@gmail.com"
SMTP_PASS="tu-app-password"
SMTP_FROM="Confecciones Juany <tu.gmail@gmail.com>"

# A dónde llegan las cotizaciones (si se omite, usa SMTP_USER)
QUOTES_TO_EMAIL="tu.gmail@gmail.com"
