generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum ProductCategory {
  graduaciones
  marketing
}

enum ProductAvailability {
  DISPONIBLE
  A_PEDIDO
}

enum QuoteStatus {
  NEW
  IN_REVIEW
  QUOTED
  ACCEPTED
  REJECTED
}

enum ProductOptionType {
  COLOR
  TEXT
  FILE
}

model AdminUser {
  id             Int             @id @default(autoincrement())
  email          String          @unique
  passwordHash   String
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  notes          QuoteNote[]
  quoteRevisions QuoteRevision[]
}

model Product {
  id            String               @id @default(cuid())
  name          String
  description   String
  category      ProductCategory
  price         Int
  images        String               @default("[]")
  tags          String               @default("[]")
  specs         String               @default("[]")
  personalization String
  minOrder      String
  leadTime      String
  availability  ProductAvailability
  badge         String?
  sampleEligible Boolean
  stockNote     String?
  isActive      Boolean              @default(true)
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt
  quoteItems    QuoteItem[]
  options       ProductOption[]
}

model ProductOption {
  id        Int               @id @default(autoincrement())
  productId String
  type      ProductOptionType
  label     String
  required  Boolean           @default(false)
  choices   String            @default("[]")
  sortOrder Int               @default(0)
  product   Product           @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

model Quote {
  id              Int         @id @default(autoincrement())
  status          QuoteStatus @default(NEW)
  customerName    String
  customerEmail   String
  customerPhone   String?
  customerMessage String?
  subtotal        Int
  // Subtotal de la solicitud original (precios de catálogo); `subtotal` pasa a ser el neto cotizado
  referenceSubtotal Int     @default(0)
  adminMessage    String?
  quotedAt        DateTime?
  // Marcada como «Cotizada» a mano sin emisión desde el sistema (p. ej. enviada por WhatsApp)
  externallyQuotedAt DateTime?
  // Token no adivinable para descargar el PDF desde el portal (los folios son correlativos)
  publicToken     String?     @unique
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  items           QuoteItem[]
  notes           QuoteNote[]
  revisions       QuoteRevision[]
}

model QuoteItem {
  id              Int     @id @default(autoincrement())
  quoteId         Int
  productId       String
  quantity        Int
  unitPrice       Int
  quotedUnitPrice Int?
  productSnapshot String
  configuration   String  @default("[]")

  quote   Quote   @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])

  @@index([quoteId])
  @@index([productId])
}

model QuoteNote {
  id          Int      @id @default(autoincrement())
  quoteId     Int
  adminUserId Int
  body        String
  isPublic    Boolean  @default(false)
  createdAt   DateTime @default(now())

  quote     Quote     @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  adminUser AdminUser @relation(fields: [adminUserId], references: [id], onDelete: Cascade)

  @@index([quoteId])
  @@index([adminUserId])
}

// Cada emisión formal del PDF. rev 0 = <folio>.pdf, rev N = <folio>-revN.pdf. Nunca se sobrescribe.
model QuoteRevision {
  id          Int       @id @default(autoincrement())
  quoteId     Int
  rev         Int
  filePath    String
  sha256      String
  netAmount   Int
  ivaAmount   Int
  totalAmount Int
  validUntil  DateTime
  issuedAt    DateTime
  sentAt      DateTime?
  adminUserId Int

  quote     Quote     @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  adminUser AdminUser @relation(fields: [adminUserId], references: [id])

  @@unique([quoteId, rev])
  @@index([adminUserId])
}

model ContactMessage {
  id        Int      @id @default(autoincrement())
  name      String
  email     String
  phone     String?
  company   String?
  message   String
  handled   Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([createdAt])
}
