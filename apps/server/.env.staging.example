# Staging en el ASUS: build de producción con datos y correo de prueba. Lo usa scripts/staging.sh.
# Copia este archivo a apps/server/.env.staging (no se versiona), complétalo y deja permisos 600.
# Las rutas relativas son respecto de apps/server (DATABASE_URL, respecto de apps/server/prisma).

NODE_ENV=production
# Permite el correo simulado (outbox) con NODE_ENV=production
STAGING=true
PORT=3101

# Base propia, separada de prisma/dev.db. scripts/staging.sh la crea y la siembra si no existe.
DATABASE_URL=file:./staging.db

# Al menos 32 caracteres: openssl rand -hex 32
JWT_SECRET=

# URL desde la que se abre el staging (va en los correos y en el PDF). Con `tailscale serve`:
# https://<máquina>.<tailnet>.ts.net
PUBLIC_SITE_URL=http://localhost:3101

# Días corridos de validez de cada cotización formal
QUOTE_VALIDITY_DAYS=30

# Sin correos reales todavía: cada correo queda como JSON en MAIL_OUTBOX_DIR
MAIL_TRANSPORT=outbox
SMTP_FROM="Confecciones Juany Reyes <taller@staging.invalid>"
QUOTES_TO_EMAIL=taller@staging.invalid

# Archivos de staging, separados de los de desarrollo (storage/quotes, storage/outbox, uploads)
QUOTES_STORAGE_DIR=storage/staging/quotes
MAIL_OUTBOX_DIR=storage/staging/outbox
UPLOADS_DIR=storage/staging/uploads

# Admin que crea el seed la primera vez (después se cambia en la base, no aquí)
ADMIN_EMAIL=
# Al menos 8 caracteres
ADMIN_PASSWORD=

# Detrás de `tailscale serve` (proxy en la misma máquina): el rate limit usa la IP real del visitante
TRUST_PROXY=loopback
